/* HUD: точка прицела в центре; при наведении на интерактивный объект - кольцо и подпись с клавишей. */

.hud-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hud-crosshair {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.7);
    transition-property: width, height, border-radius, background-color;
    transition-duration: 0.08s;
}

.hud-crosshair--active {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(255, 236, 205, 0.95);
}

.hud-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 54%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.hud-prompt__key {
    min-width: 28px;
    height: 28px;
    padding: 0 7px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(255, 255, 255, 0.85);
    background-color: rgba(0, 0, 0, 0.6);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-prompt__action {
    color: rgba(255, 255, 255, 0.95);
    font-size: 17px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}
