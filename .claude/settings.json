{
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -ExecutionPolicy Bypass -File Tools/verify.ps1*)",
      "Bash(pwsh -NoProfile -ExecutionPolicy Bypass -File Tools\\verify.ps1*)",
      "PowerShell(pwsh -NoProfile -ExecutionPolicy Bypass -File Tools/verify.ps1*)",
      "PowerShell(pwsh -NoProfile -ExecutionPolicy Bypass -File Tools\\verify.ps1*)",
      "Bash(unity status*)",
      "Bash(unity list*)",
      "Bash(unity command*)",
      "Bash(unity cmd*)",
      "Bash(unity mcp*)",
      "PowerShell(unity status*)",
      "PowerShell(unity list*)",
      "PowerShell(unity command*)",
      "PowerShell(unity cmd*)",
      "PowerShell(unity mcp*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)"
    ],
    "ask": [
      "Edit(Packages/manifest.json)",
      "Edit(Packages/packages-lock.json)",
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(rm *)",
      "Bash(git rm*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(git rm*)",
      "Bash(unity pipeline*)",
      "PowerShell(unity pipeline*)",
      "Bash(unity command package*)",
      "Bash(unity cmd package*)",
      "PowerShell(unity command package*)",
      "PowerShell(unity cmd package*)",
      "Bash(unity command script eval*)",
      "Bash(unity command script run*)",
      "Bash(unity cmd script eval*)",
      "Bash(unity cmd script run*)",
      "PowerShell(unity command script eval*)",
      "PowerShell(unity command script run*)",
      "PowerShell(unity cmd script eval*)",
      "PowerShell(unity cmd script run*)"
    ],
    "deny": [
      "Read(Library/**)",
      "Read(Temp/**)",
      "Read(UserSettings/**)",
      "Read(**/*.csproj)",
      "Read(*.slnx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-packages.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/Tools/notify.ps1\" -Message \"Готово, жду тебя\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/Tools/notify.ps1\" -Message \"Нужно твоё разрешение\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
